---
import Base from '../layouts/Base.astro';
import { clinics, site, proof, bookingHref } from '../data/site.js';
---

<Base
  title="Clinics in Delhi — Narela and Rohini"
  description="Dr Hitesh Aggarwal consults at Narela in the morning and Rohini in the evening, Monday to Saturday. Addresses, timings and directions."
  slug="clinics"
  pageType="index"
>
  <section class="wrap band">
    <h1>Clinics</h1>
    <p class="lead" style="margin-top:14px">
      Two clinics in Delhi — Narela in the morning, Rohini in the evening, Monday to Saturday. If
      travelling is difficult, <a href="/consult-online/">an online consultation</a> covers most
      skin and hair concerns.
    </p>

    <div class="grid grid-2" style="margin-top:32px; gap:20px">
      {
        clinics.map((c) => (
          <div class="card" style="padding:24px">
            <h2 style="font-size:var(--t-h3); margin-bottom:10px">{c.name}</h2>
            <p>{c.address}</p>
            <p style="margin-top:12px; color:var(--ink); font-weight:600">{c.hours}</p>
            <p style="font-size:var(--t-small)">{c.closed}</p>
            <p style="font-size:var(--t-small); margin-top:10px">
              {c.rating} ★ · {c.reviewCount} Google reviews
            </p>
            <div class="actions" style="margin-top:18px">
              <a
                class="btn btn-primary"
                style="padding:10px 18px"
                href={bookingHref({ clinic: c.name })}
                rel="noopener"
                data-track="booking_started"
                data-mode="clinic"
                data-clinic={c.slug}
                data-placement="clinics_page"
              >
                Book here
              </a>
              <a
                class="btn btn-secondary"
                style="padding:10px 18px"
                href={c.mapsUrl}
                rel="noopener"
                data-track="clinic_map_opened"
                data-clinic={c.slug}
              >
                Directions
              </a>
              <a
                class="btn btn-secondary"
                style="padding:10px 18px"
                href={`tel:${site.phone}`}
                data-track="phone_clicked"
                data-clinic={c.slug}
                data-placement="clinics_page"
              >
                Call
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <div style="max-width:720px; margin-top:44px">
      <h2 style="font-size:var(--t-h3)">Before you come</h2>
      <ul style="color:var(--ink-2); margin:14px 0 0 1.15em">
        <li style="margin-bottom:8px">
          Bring every cream, tablet or oil you are using — including anything bought without a
          prescription. This changes the diagnosis more often than people expect.
        </li>
        <li style="margin-bottom:8px">Bring previous prescriptions and any test reports.</li>
        <li style="margin-bottom:8px">
          If the problem comes and goes, bring photographs of it at its worst.
        </li>
        <li>
          Appointments are advisable, particularly at Rohini where the evening window is short.
        </li>
      </ul>

      <div class="note" style="margin-top:28px">
        <h3>Across both clinics</h3>
        <p>
          {proof.totalReviews} Google reviews at an average of {proof.averageRating}. The reviews
          are unusually specific — patients name the condition they were treated for, which is
          more useful than a star rating on its own.
        </p>
      </div>

      <h2 style="font-size:var(--t-h3); margin-top:36px">Contact</h2>
      <p>
        <a href={`tel:${site.phone}`} data-track="phone_clicked" data-placement="clinics_contact">
          {site.phoneDisplay}
        </a><br />
        <a href={bookingHref()} rel="noopener" data-track="whatsapp_clicked" data-placement="clinics_contact">
          WhatsApp
        </a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </section>
</Base>
